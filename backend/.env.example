# PR Sentinel Backend - Environment Configuration Template

# Server Configuration
# Note: On Render, PORT is assigned dynamically by the host environment.
# Locally it defaults to 5000 if not specified.
PORT=5000
NODE_ENV=production

# Production Frontend Origin (Render Web Service or custom domain)
# Example: https://pr-sentinel-app.onrender.com
# Trailing slashes are automatically stripped by the server.
FRONTEND_URL=

# Additional CORS Origins (comma-separated, optional)
# Localhost development ports (5173, 5174) are always allowed by default.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# SQLite Database File Path
# Default: ./data/sentinel.db (inside the backend project root)
#
# IMPORTANT PERSISTENCE NOTICE FOR RENDER:
# Render's free/starter instances use an ephemeral filesystem. Any changes written
# to the local disk are lost when the service restarts, redeploys, or spins down.
# For persistent SQLite data on Render:
# 1. Attach a Render Persistent Disk (e.g. mounted at /var/data)
# 2. Set DB_PATH=/var/data/sentinel.db
DB_PATH=./data/sentinel.db
